# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSLATOR_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0
N_QUERY_VARIANTS=3

# Embeddings and vector store
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
CHROMA_DIR=./chroma

# RAG runtime
RAG_PROFILE=balanced
RAG_CACHE_DIR=./.cache/rag
RAG_UPLOAD_DIR=./media/documents
MAX_UPLOAD_SIZE_MB=50

# Optional: cost reporting
GROQ_INPUT_COST_PER_1M=0
GROQ_OUTPUT_COST_PER_1M=0

# Optional services
TAVILY_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=open-rag
